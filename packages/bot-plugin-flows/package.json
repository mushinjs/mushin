{
  "name": "@mushin/bot-plugin-flows",
  "version": "0.1.0",
  "description": "Runs the conversation flows attached to a bot",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "bot",
    "platforms": [
      "onebot"
    ],
    "category": "flows",
    "displayName": {
      "en": "Conversation flows",
      "zh-CN": "对话流程"
    },
    "description": {
      "en": "Runs the flows attached to this bot, before other plugins see the message",
      "zh-CN": "运行绑定到此机器人的流程，先于其他插件处理消息"
    },
    "requires": {
      "plugins": {
        "@mushin/plugin-bots": "*",
        "@mushin/plugin-flows": "*"
      }
    }
  },
  "dependencies": {
    "@mushin/core": "workspace:*",
    "@mushin/plugin-bots": "workspace:*",
    "@mushin/plugin-flows": "workspace:*"
  }
}
