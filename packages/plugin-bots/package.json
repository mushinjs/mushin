{
  "name": "@mushinjs/plugin-bots",
  "version": "0.2.0",
  "description": "Bot manager and per-bot runtimes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-bots"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "essential": true,
    "displayName": {
      "en": "Bots",
      "zh-CN": "机器人"
    },
    "description": {
      "en": "Creates bots and runs each in its own isolated context",
      "zh-CN": "创建机器人，并为每个机器人运行独立的上下文"
    },
    "provides": [
      "bots",
      "bot"
    ],
    "requires": {
      "plugins": {
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-database": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-database": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "minato": "catalog:"
  }
}
