{
  "name": "@mushinjs/cli",
  "version": "0.1.0",
  "description": "Mushin.js launcher",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mushin": "./bin/mushin.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"../dashboard/**\" src/dev.ts start --dir ../../instance",
    "demo": "tsx tests/helpers/demo.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "cordis": "catalog:",
    "@cordisjs/plugin-server": "catalog:",
    "tsx": "catalog:",
    "@mushinjs/plugin-storage": "workspace:*",
    "@mushinjs/plugin-database": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@mushinjs/plugin-provider-openai": "workspace:*",
    "@mushinjs/plugin-provider-anthropic": "workspace:*",
    "@mushinjs/plugin-provider-gemini": "workspace:*",
    "@mushinjs/plugin-provider-typesafe": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-adapter-onebot": "workspace:*",
    "@mushinjs/plugin-agent": "workspace:*",
    "@mushinjs/plugin-console": "workspace:*",
    "@mushinjs/bot-plugin-echo": "workspace:*",
    "@mushinjs/bot-plugin-llm-chat": "workspace:*",
    "@mushinjs/bot-plugin-companion": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/bot-plugin-flows": "workspace:*",
    "@mushinjs/plugin-demo": "workspace:*",
    "@mushinjs/plugin-stats": "workspace:*",
    "@mushinjs/plugin-permissions": "workspace:*",
    "@mushinjs/plugin-personas": "workspace:*",
    "@mushinjs/plugin-mcp": "workspace:*",
    "@mushinjs/plugin-terminal": "workspace:*",
    "@mushinjs/plugin-knowledge": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:",
    "ws": "catalog:"
  }
}
