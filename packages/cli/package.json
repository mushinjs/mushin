{
  "name": "@mushin/cli",
  "version": "0.1.0",
  "description": "Mushin.js launcher",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mushin": "./bin/mushin.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/dev.ts start --dir ../../instance",
    "demo": "tsx tests/helpers/demo.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mushin/core": "workspace:*",
    "@cordisjs/plugin-server": "catalog:",
    "tsx": "catalog:",
    "@mushin/plugin-storage": "workspace:*",
    "@mushin/plugin-providers": "workspace:*",
    "@mushin/plugin-provider-openai": "workspace:*",
    "@mushin/plugin-provider-anthropic": "workspace:*",
    "@mushin/plugin-bots": "workspace:*",
    "@mushin/plugin-adapter-onebot": "workspace:*",
    "@mushin/plugin-agent": "workspace:*",
    "@mushin/plugin-console": "workspace:*",
    "@mushin/bot-plugin-echo": "workspace:*",
    "@mushin/bot-plugin-llm-chat": "workspace:*",
    "@mushin/plugin-flows": "workspace:*",
    "@mushin/bot-plugin-flows": "workspace:*",
    "@mushin/plugin-demo": "workspace:*",
    "@mushin/plugin-stats": "workspace:*",
    "@mushin/plugin-permissions": "workspace:*",
    "@mushin/plugin-personas": "workspace:*",
    "@mushin/plugin-mcp": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:",
    "ws": "catalog:"
  }
}
