{
  "name": "@mushinjs/plugin-flows",
  "version": "0.2.0",
  "description": "Conversation flows: node registry, execution engine and flow storage",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-flows"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Conversation flows",
      "zh-CN": "对话流程"
    },
    "description": {
      "en": "Build bot behavior visually from nodes; other plugins can add node types",
      "zh-CN": "用节点可视化地编排机器人行为；其他插件可以添加节点类型"
    },
    "provides": [
      "flows"
    ],
    "requires": {
      "plugins": {
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-providers": "*",
        "@mushinjs/plugin-database": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-database": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "minato": "catalog:"
  }
}
