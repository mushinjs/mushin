{
  "name": "@mushinjs/plugin-personas",
  "version": "0.1.0",
  "description": "Personas shared by bots, LLM chat and flows: a character, a voice and example exchanges, chosen per chat",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-personas"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "category": "ai",
    "displayName": {
      "en": "Personas",
      "zh-CN": "人格"
    },
    "description": {
      "en": "Characters with a voice, background and example exchanges; bots pick one per group, user or time of day, and LLM chat and flows speak as it",
      "zh-CN": "带有性格、说话风格、背景和示例对话的人格；机器人可按群、用户或时间段选择，大模型对话和流程以它的口吻说话"
    },
    "provides": [
      "personas"
    ],
    "requires": {
      "mushin": ">=0.1.0",
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-permissions": "*"
      }
    },
    "nodes": [
      "persona.use"
    ]
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*"
  }
}
