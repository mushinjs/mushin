{
  "name": "@mushinjs/plugin-console",
  "version": "0.2.0",
  "description": "HTTP API, WebSocket and dashboard hosting",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-console"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "essential": true,
    "displayName": {
      "en": "Console",
      "zh-CN": "控制台"
    },
    "description": {
      "en": "Serves the dashboard and its API",
      "zh-CN": "提供控制台页面及其 API"
    },
    "provides": [
      "console"
    ],
    "requires": {
      "plugins": {
        "@cordisjs/plugin-server": "*",
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-agent": "*",
        "@mushinjs/plugin-providers": "*",
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-stats": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-agent": "workspace:*",
    "@cordisjs/plugin-server": "catalog:",
    "ws": "catalog:",
    "@mushinjs/dashboard": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/plugin-stats": "workspace:*"
  }
}
