{
  "name": "@mushin/plugin-storage",
  "version": "0.1.0",
  "description": "JSON document storage",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-storage"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "essential": true,
    "displayName": {
      "en": "Storage",
      "zh-CN": "存储"
    },
    "description": {
      "en": "Stores providers, bots and sessions as JSON files",
      "zh-CN": "以 JSON 文件保存提供商、机器人与会话"
    },
    "provides": [
      "storage"
    ]
  },
  "dependencies": {
    "@mushin/core": "workspace:*"
  }
}
