{
  "name": "@mushinjs/plugin-terminal",
  "version": "0.3.0",
  "description": "Lets Fairy run commands and edit files on this machine, and flow nodes that run commands locally or over SSH",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-terminal"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "category": "feature",
    "displayName": {
      "en": "Terminal",
      "zh-CN": "终端"
    },
    "description": {
      "en": "Lets Fairy run commands and read and write files on this machine (asking first, as set here), and adds flow nodes that run commands here or on servers over SSH, which only you can add",
      "zh-CN": "让 Fairy 在本机运行命令、读写文件（按这里的设置先问你），并提供在本机或通过 SSH 在服务器上运行命令的流程节点（只能由你添加）"
    },
    "requires": {
      "mushin": ">=0.1.0",
      "plugins": {
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-storage": "*"
      }
    },
    "nodes": [
      "terminal.*"
    ]
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "ssh2": "catalog:"
  },
  "devDependencies": {
    "@types/ssh2": "catalog:"
  }
}
