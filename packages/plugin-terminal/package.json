{
  "name": "@mushin/plugin-terminal",
  "version": "0.1.0",
  "description": "Flow nodes that run commands in a local terminal or over SSH",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Terminal",
      "zh-CN": "终端"
    },
    "description": {
      "en": "Flow nodes that run commands on this machine or on servers over SSH; only you can add them, not the Agent",
      "zh-CN": "在本机或通过 SSH 在服务器上运行命令的流程节点；只能由你添加，智能体不能"
    },
    "requires": {
      "mushin": ">=0.1.0",
      "plugins": {
        "@mushin/plugin-flows": "*",
        "@mushin/plugin-storage": "*"
      }
    },
    "nodes": [
      "terminal.*"
    ]
  },
  "dependencies": {
    "@mushin/core": "workspace:*",
    "@mushin/plugin-flows": "workspace:*",
    "@mushin/plugin-storage": "workspace:*",
    "ssh2": "catalog:"
  },
  "devDependencies": {
    "@types/ssh2": "catalog:"
  }
}
