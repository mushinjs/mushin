{
  "name": "@mushinjs/plugin-provider-anthropic",
  "version": "0.1.0",
  "description": "Anthropic provider type",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-provider-anthropic"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Anthropic provider",
      "zh-CN": "Anthropic 提供商"
    },
    "description": {
      "en": "Claude models through the Anthropic Messages API, plus the Anthropic-compatible endpoints of DeepSeek, Kimi, Zhipu and MiniMax",
      "zh-CN": "通过 Anthropic Messages API 使用 Claude 模型，也支持 DeepSeek、Kimi、智谱、MiniMax 的 Anthropic 兼容接口"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-providers": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@anthropic-ai/sdk": "catalog:"
  }
}
