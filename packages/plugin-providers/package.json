{
  "name": "@mushinjs/plugin-providers",
  "version": "0.1.0",
  "description": "LLM provider management and the llm service",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-providers"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "essential": true,
    "displayName": {
      "en": "Providers",
      "zh-CN": "模型提供商"
    },
    "description": {
      "en": "Manages LLM providers and exposes ctx.llm",
      "zh-CN": "管理大模型提供商并提供 ctx.llm 服务"
    },
    "provides": [
      "llm"
    ],
    "requires": {
      "plugins": {
        "@mushinjs/plugin-storage": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*"
  }
}
