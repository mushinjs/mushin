{
  "name": "@mushinjs/bot-plugin-companion",
  "version": "0.2.0",
  "description": "Companion bot plugin: chats in groups like a member, deciding for itself when to speak",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/bot-plugin-companion"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "bot",
    "platforms": [
      "onebot"
    ],
    "category": "ai",
    "displayName": {
      "en": "Companion chat",
      "zh-CN": "拟人群聊"
    },
    "description": {
      "en": "Reads the group like a member: waits for people to finish, decides whether to speak, and replies in a few short messages",
      "zh-CN": "像群友一样看群聊：等对方说完，自己判断要不要说话，分几条短消息回复"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-providers": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-personas": "*",
        "@mushinjs/plugin-database": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-database": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/plugin-personas": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "minato": "catalog:"
  }
}
