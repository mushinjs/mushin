{
  "name": "@mushinjs/plugin-adapter-onebot",
  "version": "0.3.0",
  "description": "OneBot v11 adapter",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-adapter-onebot"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "category": "adapter",
    "displayName": {
      "en": "OneBot v11 adapter",
      "zh-CN": "OneBot v11 适配器"
    },
    "description": {
      "en": "Connects bots to any OneBot v11 implementation, such as NapCat, Lagrange or LLOneBot",
      "zh-CN": "将机器人连接到任意 OneBot v11 实现，如 NapCat、Lagrange、LLOneBot"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@cordisjs/plugin-server": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-flows": "*"
      }
    },
    "nodes": [
      "onebot.*"
    ]
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@cordisjs/plugin-server": "catalog:",
    "ws": "catalog:"
  }
}
