{
  "name": "@mushin/bot-plugin-llm-chat",
  "version": "0.1.0",
  "description": "LLM chat bot plugin: makes an editable chat flow on each bot",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "bot",
    "platforms": [
      "onebot"
    ],
    "category": "ai",
    "displayName": {
      "en": "LLM chat",
      "zh-CN": "大模型对话"
    },
    "description": {
      "en": "Makes a flow that replies with an LLM when mentioned or in private chat; edit it on the canvas",
      "zh-CN": "创建一个被 @ 或私聊时用大模型回复的流程，可以在画布上调整"
    },
    "requires": {
      "plugins": {
        "@mushin/plugin-bots": "*",
        "@mushin/plugin-flows": "*",
        "@mushin/plugin-providers": "*",
        "@mushin/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushin/plugin-personas": "*"
      }
    }
  },
  "dependencies": {
    "@mushin/core": "workspace:*",
    "@mushin/plugin-bots": "workspace:*",
    "@mushin/plugin-providers": "workspace:*",
    "@mushin/plugin-storage": "workspace:*",
    "@mushin/plugin-flows": "workspace:*"
  }
}
