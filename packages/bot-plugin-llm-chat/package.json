{
  "name": "@mushinjs/bot-plugin-llm-chat",
  "version": "0.2.0",
  "description": "LLM chat bot plugin: makes an editable chat flow on each bot",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/bot-plugin-llm-chat"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "bot",
    "platforms": [
      "onebot"
    ],
    "category": "ai",
    "displayName": {
      "en": "LLM chat",
      "zh-CN": "大模型对话"
    },
    "description": {
      "en": "Makes a flow that replies with an LLM when mentioned or in private chat; edit it on the canvas",
      "zh-CN": "创建一个被 @ 或私聊时用大模型回复的流程，可以在画布上调整"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-providers": "*",
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-personas": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*"
  }
}
