{
  "name": "@mushinjs/bot-plugin-echo",
  "version": "0.2.0",
  "description": "Echo bot plugin: the minimal example",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/bot-plugin-echo"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "bot",
    "platforms": [
      "onebot"
    ],
    "category": "example",
    "displayName": {
      "en": "Echo",
      "zh-CN": "复读"
    },
    "description": {
      "en": "Replies to \"echo <text>\" with the text",
      "zh-CN": "收到「echo 内容」时原样回复内容"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-bots": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*"
  }
}
