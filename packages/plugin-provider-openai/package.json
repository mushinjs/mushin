{
  "name": "@mushinjs/plugin-provider-openai",
  "version": "0.1.0",
  "description": "OpenAI-compatible provider type",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-provider-openai"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "OpenAI-compatible provider",
      "zh-CN": "OpenAI 兼容提供商"
    },
    "description": {
      "en": "OpenAI, Azure OpenAI, DeepSeek, Moonshot, Qwen, SiliconFlow, OpenRouter, Zhipu GLM, Doubao, Qianfan, Hunyuan, MiniMax, StepFun, xAI, Groq, Mistral, Gemini, Together, Ollama, LM Studio, vLLM",
      "zh-CN": "支持 OpenAI、Azure OpenAI、DeepSeek、Moonshot、通义千问、硅基流动、OpenRouter、智谱 GLM、豆包、千帆、混元、MiniMax、阶跃星辰、xAI、Groq、Mistral、Gemini、Together、Ollama、LM Studio、vLLM"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-providers": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "openai": "catalog:"
  }
}
