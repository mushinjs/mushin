{
  "name": "@mushinjs/plugin-provider-gemini",
  "version": "0.2.0",
  "description": "Google Gemini provider type",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-provider-gemini"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Gemini provider",
      "zh-CN": "Gemini 提供商"
    },
    "description": {
      "en": "Google Gemini models through the native Gemini API, with tools, images and embeddings",
      "zh-CN": "通过 Gemini 原生 API 使用 Google Gemini 模型，支持工具调用、图片与向量嵌入"
    },
    "requires": {
      "plugins": {
        "@mushinjs/plugin-providers": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*"
  }
}
