{
  "name": "@mushinjs/plugin-stats",
  "version": "0.2.0",
  "description": "Usage statistics and runtime performance for the overview page",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-stats"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Statistics",
      "zh-CN": "统计"
    },
    "description": {
      "en": "Counts messages, commands, flow runs and model usage by hour, and samples CPU and memory for the overview page",
      "zh-CN": "按小时统计消息、指令、流程运行和模型用量，并采样 CPU 与内存，供总览页使用"
    },
    "provides": [
      "stats"
    ],
    "requires": {
      "plugins": {
        "@mushinjs/plugin-storage": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-bots": "*",
        "@mushinjs/plugin-flows": "*",
        "@mushinjs/plugin-providers": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-bots": "workspace:*",
    "@mushinjs/plugin-flows": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "cordis": "catalog:"
  }
}
