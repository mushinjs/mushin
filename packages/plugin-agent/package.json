{
  "name": "@mushinjs/plugin-agent",
  "version": "0.2.0",
  "description": "The Mushin.js Agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushinjs/mushin.git",
    "directory": "packages/plugin-agent"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "mushin-plugin"
  ],
  "mushin": {
    "kind": "app",
    "displayName": {
      "en": "Agent",
      "zh-CN": "智能体"
    },
    "description": {
      "en": "Operate Mushin.js through natural-language conversation",
      "zh-CN": "通过自然语言对话操作 Mushin.js"
    },
    "provides": [
      "agent"
    ],
    "requires": {
      "plugins": {
        "@mushinjs/plugin-storage": "*",
        "@mushinjs/plugin-providers": "*"
      }
    },
    "optional": {
      "plugins": {
        "@mushinjs/plugin-bots": "*"
      }
    }
  },
  "dependencies": {
    "@mushinjs/core": "workspace:*",
    "@mushinjs/plugin-storage": "workspace:*",
    "@mushinjs/plugin-providers": "workspace:*"
  }
}
