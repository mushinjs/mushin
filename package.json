{
  "name": "mushin-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "mushin start --dir instance",
    "dev": "pnpm --filter @mushinjs/cli dev",
    "demo": "pnpm --filter @mushinjs/cli demo",
    "build": "tsx scripts/build.ts && pnpm --filter @mushinjs/dashboard build",
    "build:packages": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:pack": "tsx scripts/pack-test.ts",
    "test:flows": "mushin test --dir instance",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @mushinjs/dashboard typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@mushinjs/cli": "workspace:*",
    "@mushinjs/core": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@iconify/json": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vitest": "catalog:"
  }
}
